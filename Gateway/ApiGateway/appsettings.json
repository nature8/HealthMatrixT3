{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "patientRoute": {
        "ClusterId": "patientCluster",
        "Match": {
          "Path": "/patient/{**catch-all}"
        }
      },
      "doctorRoute": {
        "ClusterId": "doctorCluster",
        "Match": {
          "Path": "/doctor/{**catch-all}"
        }
      },
      "notificationRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/doctor/{**catch-all}"
        }
      },
      "appointmentRoute": {
        "ClusterId": "appointmentCluster",
        "Match": {
          "Path": "/appointment/{**catch-all}"
        }
      },
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/doctor/{**catch-all}"
        }
      },
      "billingRoute": {
        "ClusterId": "billingCluster",
        "Match": {
          "Path": "/billing/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "patientCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5290/"
          }
        }
      },
      "doctorCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7204/"
          }
        }
      },
      "notificationCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5032/"
          }
        }
      },
      "appointmentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5056/"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5098/"
          }
        }
      },
      "billingCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5298/"
          }
        }
      },
      "medicalRecordCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5041/"
          }
        }
      }
    }
  }
}

