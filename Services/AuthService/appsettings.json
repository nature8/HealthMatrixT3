{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
  "DefaultConnection": "Server=.\\SQLEXPRESS;Database=HMAuthDB;Trusted_Connection=True;TrustServerCertificate=True;"
},

   "Jwt": {
    "Key": "HealthMatrixT3SuperSecretKey123456789",
    "Issuer": "HealthMatrixAuth",
    "Audience": "HealthMatrixUsers",
    "ExpiryMinutes": 60
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "Logs/log-.txt", "rollingInterval": "Day" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithEnvironmentName" ]
  }

}
